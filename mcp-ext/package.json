{
  "name": "affine-mcp-ext",
  "version": "1.3.0",
  "description": "MCP proxy that extends AFFiNE's built-in MCP server with additional tools sourced from the GraphQL API and write tools built on Yjs CRDT",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fractional-indexing": "^4.0.0",
    "nanoid": "^6.0.0",
    "socket.io-client": "^4.8.3",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  }
}
