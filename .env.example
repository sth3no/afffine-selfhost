# =========================================================
# AFFiNE + MCP Agent — Portainer stack environment
# Copy to `.env` (or paste into Portainer's "Environment variables" UI)
# =========================================================

# ---- AFFiNE image ----
# Use `stable` for production, `canary` for latest dev features (required for MCP write ops)
AFFINE_REVISION=stable

# External port where AFFiNE is exposed on the host
PORT=3010

# Public URL users will access. Pick ONE approach:
#
#  (a) Single URL (simplest):
AFFINE_SERVER_EXTERNAL_URL=http://localhost:3010
#
#  (b) Split host + scheme (matches upstream docs; leave URL blank if using this):
# AFFINE_SERVER_HOST=affine.example.com
# AFFINE_SERVER_HTTPS=true
AFFINE_SERVER_HOST=
AFFINE_SERVER_HTTPS=

# ---- Database ----
DB_USERNAME=affine
DB_PASSWORD=change-me-to-a-strong-password
DB_DATABASE=affine

# ---- Mailer (optional — leave blank to disable email features) ----
MAILER_HOST=
MAILER_PORT=
MAILER_USER=
MAILER_PASSWORD=
MAILER_SENDER=

# ---- MCP Agent ----
# Leave these blank on FIRST deploy. After AFFiNE is up:
#   1. Open http://<host>:3010 and create the admin account
#   2. Go to Workspace Settings → Integration → MCP Server → Generate Token
#   3. Copy the workspace ID from the URL (/workspace/<ID>/...)
#   4. Set these two values and redeploy the stack (or just the mcp_agent service)
AFFINE_WORKSPACE_ID=
AFFINE_ACCESS_TOKEN=

# Timezone used by node-cron inside the agent
TZ=UTC

# ---- Search (Manticore) ----
# Enables AFFiNE's full-text and semantic search. Powers the MCP tools
# keyword_search and semantic_search. A Manticore container is part of
# the stack — the server auto-indexes existing workspaces in batches.
AFFINE_INDEXER_ENABLED=true

# Manticore image tag (pinned for reproducible builds). The search index is
# rebuildable — if a bump ever misbehaves, roll back to 10.1.0 and AFFiNE
# re-indexes automatically (delete the manticore_data volume to force it).
MANTICORE_VERSION=27.1.5

# ---- MCP extension proxy ----
# Port on the HOST where the extended MCP (11 tools) is published.
# Use this URL in Claude Desktop / Cursor / n8n:
#   http://<your-host>:3100/
MCP_EXT_PORT=3100
# Restrict to localhost only by setting to 127.0.0.1 (hides it from LAN/WAN).
# Default 0.0.0.0 = all interfaces, matching how AFFiNE itself is exposed.
MCP_EXT_BIND=0.0.0.0

# ---- MCP server (full DAWNCR0W fork) ----
# The comprehensive AFFiNE MCP server — 85 tools (docs, edgeless canvas,
# databases, templates, tags, collections). Built from ./mcp-server.
# Runs alongside the mcp_ext proxy, not as a replacement.
# Endpoint for Claude / Cursor / n8n:  http://<your-host>:3300/mcp
#
# REQUIRED — bearer secret. Every client request to /mcp must send
#   Authorization: Bearer <this value>
# Generate a fresh one with:  openssl rand -hex 32
AFFINE_MCP_HTTP_TOKEN=

# Host port where the MCP server is published. 3100 = mcp_ext, 3200 = ingest,
# so this uses 3300. Restrict to localhost with MCP_SERVER_BIND=127.0.0.1.
MCP_SERVER_PORT=3300
MCP_SERVER_BIND=0.0.0.0

# Tool surface profile:
#   full       — all 85 tools, incl. destructive (delete_*) and admin
#   authoring  — full editing incl. edgeless canvas, NO destructive/admin
#   core       — compact everyday surface (~27 tools)
#   read_only  — discovery / read / export only
AFFINE_MCP_TOOL_PROFILE=full
# Reuses AFFINE_ACCESS_TOKEN and AFFINE_WORKSPACE_ID from the MCP Agent section above.

# ---- Cross-stack networking (n8n etc.) ----
# External Docker network shared with other Portainer stacks.
# Create ONCE on the host before deploying this stack:
#   docker network create shared_net
# Then attach your other stacks (n8n, etc.) to the SAME network name.
# From n8n workflows you can then reach AFFiNE at: http://affine:3010
SHARED_NETWORK=shared_net

# === Ingest service (Python, port 3200) =====================================
# Generate a strong token: `openssl rand -hex 32`. iOS app sends this as
# `Authorization: Bearer <token>`. Rotate by editing this file in Portainer
# and re-deploying the stack.
INGEST_API_TOKEN=

# Hosted API keys. Anthropic key powers classification (Haiku 4.5) and the
# weekly reorganizer (Sonnet 4.6). OpenAI key powers Whisper transcription
# and text-embedding-3-small (folder-name similarity).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Host port + bind interface for the ingest API. Default 0.0.0.0 means
# anything that can reach the Docker host can hit it (typically you put a
# reverse proxy in front). Set INGEST_BIND=127.0.0.1 to restrict to the
# host only and let only an internal proxy reach it.
INGEST_PORT=3200
INGEST_BIND=0.0.0.0

# Per-capture cost guards. MAX_TRANSCRIPT_MIN caps Whisper API spend
# per video (longer videos use captions only or skip transcript with a
# note). REORG_THRESHOLD_DEFAULT is the per-leaf-folder doc count above
# which the weekly reorganizer proposes a sub-cluster split.
MAX_TRANSCRIPT_MIN=30
REORG_THRESHOLD_DEFAULT=15
# Hard per-capture processing ceiling (seconds). A hung extraction is
# failed with the normal retry backoff instead of blocking a worker slot.
CAPTURE_TIMEOUT_SEC=1800
# Concurrent worker loops pumping the captures queue (head-of-line
# blocking relief: a long podcast no longer stalls every other capture).
WORKER_CONCURRENCY=2

# === Cobalt (media extractor) ===============================================
# Self-hosted imputnet/cobalt API. Default URL is the in-stack hostname;
# only override if you publish the cobalt port and want to call it from
# outside docker.
COBALT_API_URL=http://cobalt:9000

# Per-request duration cap in seconds. cobalt rejects media longer than
# this. Default 10800 = 3h, enough for podcasts; trim if you want to
# bound Whisper spend.
COBALT_DURATION_LIMIT=10800

# === Residential proxy (Phase 12.5 fix #7) ==================================
# YouTube blocks most cloud / VPS IPs from generating PO tokens via
# BotGuard AND from fetching auto-captions via youtube-transcript-api,
# regardless of cookie quality. Cookies + perfect config still hit
# `error.api.youtube.login` for niche / age-gated content from a
# Hetzner / AWS / etc. IP.
#
# Two ways to provide a residential IP egress (see README "Residential
# proxy" section for the full how-to):
#
# Option A — self-hosted via Raspberry Pi at home (recommended)
#   Run scripts/pi-residential-tunnel-setup.sh on a Pi, install
#   Tailscale on the VPS, paste the Pi's tailscale IP here:
#     RESIDENTIAL_PROXY_URL=http://100.64.0.5:8118
#   $0/month bandwidth, $2/year in power, zero rate limits.
#
# Option B — commercial residential proxy
#   Format: http://USER:PASS@gateway.provider.com:PORT
#   Examples (personal scale):
#     - Webshare: 1 GB pay-as-you-go ~$3.50
#     - Decodo (Smartproxy): ~$4/GB, cleaner pool than Webshare
#     - DataImpulse: pay-as-you-go, credits don't expire
#   Audit bandwidth — phase 13 video captures can hit 150-750 GB/month.
#
# When unset (the default), all containers fall back to direct
# connections — works for popular YT content, fails for niche.
#
# Routes through the proxy:
#   - cobalt → YouTube (audio + video download)
#   - yt_session_server (Chromium → BotGuard challenge for PO token)
#   - ingest (youtube-transcript-api + yt-dlp metadata)
#
# Direct (excluded via NO_PROXY):
#   - Inter-container traffic on affine_net
#   - api.anthropic.com, api.openai.com (no benefit, residential
#     bandwidth is metered)
RESIDENTIAL_PROXY_URL=
